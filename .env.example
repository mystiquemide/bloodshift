# Zetaris, reached over its HTTP API (the UI origin, not port 8888)
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
ZETARIS_ORG_ID=

# Synthetic hospital sources. Host ports are for seeding and site adapters.
SITE_A_USER=site_a
SITE_A_PASSWORD=
SITE_A_PORT=5433
SITE_B_USER=site_b
SITE_B_PASSWORD=
SITE_B_PORT=5434

# Site C is a CSV inside the Zetaris file root
ZETARIS_DRIVER_CONTAINER=zetaris-driver-1
SITE_C_DIR=/home/zetaris/customer-data/shared/bloodshift/site_c

# Mock courier service
COURIER_PORT=8090

# App
PORT=4000
SEED=20261024

# Transfer history (Meterless World Model log)
WORLD_DIR=data

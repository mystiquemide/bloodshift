{
  "name": "bloodshift",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sources:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d --wait",
    "sources:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
    "seed": "tsx scripts/seed.ts",
    "register": "tsx scripts/register-sources.ts",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "simulate": "tsx scripts/simulate.ts",
    "eval:declines": "tsx scripts/eval-declines.ts",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
